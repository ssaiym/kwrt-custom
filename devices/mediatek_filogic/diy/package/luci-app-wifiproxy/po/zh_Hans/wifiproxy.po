msgid "WiFi Proxy Matrix"
msgstr "WiFi 代理矩阵"

msgid "Quickly create WiFi networks bound to independent passwall proxy nodes. Each SSID gets its own subnet, DHCP pool, client isolation and a configurable client limit. Saving and applying regenerates network/dhcp/firewall/wireless and passwall ACL config."
msgstr "快速创建绑定独立 passwall 代理节点的 WiFi 信号。每个 SSID 拥有独立子网、DHCP 池、客户端隔离和可自定义的连接人数上限。保存并应用后将自动重建 network/dhcp/firewall/wireless 与 passwall ACL 配置。"

msgid "General Settings"
msgstr "通用设置"

msgid "Guest subnet base"
msgstr "访客网段基址"

msgid "Profile N uses <base>.N.0/24 (gateway <base>.N.1)."
msgstr "第 N 个方案使用 <base>.N.0/24 网段（网关 <base>.N.1）。"

msgid "WiFi Profiles"
msgstr "WiFi 方案列表"

msgid "Each profile creates one WiFi signal. The radio list shows the real radios of this device; profiles without a radio (e.g. on devices without wifi) only generate network config."
msgstr "每个方案对应一个 WiFi 信号。射频下拉框显示本机实际存在的射频；未选射频的方案（例如在无无线网卡的设备上）只生成网络配置。"

msgid "Enable"
msgstr "启用"

msgid "SSID"
msgstr "WiFi 名称 (SSID)"

msgid "WiFi Password"
msgstr "WiFi 密码"

msgid "Radio"
msgstr "无线射频"

msgid "Max clients"
msgstr "连接人数上限"

msgid "hostapd max_num_sta of this SSID."
msgstr "该 WiFi 的最大并发连接设备数（hostapd max_num_sta）。"

msgid "Proxy Node"
msgstr "代理节点"

msgid "(add nodes in passwall first)"
msgstr "（请先在 passwall 中添加节点）"

msgid "Client isolation"
msgstr "客户端隔离"

msgid "Quick Create"
msgstr "快速创建"

msgid "Batch-create WiFi profiles: proxy nodes are assigned round-robin, radios alternate when multiple radios exist, blank password = random per SSID. Takes effect after Save & Apply."
msgstr "批量生成 WiFi 方案：代理节点按顺序轮询分配；存在多个射频时交替使用 2.4G/5G；密码留空则每个 WiFi 随机生成。保存并应用后生效。"

msgid "WiFi count"
msgstr "WiFi 数量"

msgid "(select count, then Save & Apply)"
msgstr "（选择数量后点保存并应用）"

msgid "Name prefix"
msgstr "名称前缀"

msgid "WiFi password (blank = random)"
msgstr "WiFi 密码（留空 = 随机生成）"

msgid "Interface / Subnet"
msgstr "接口 / 网段"

msgid "not enabled"
msgstr "未启用"

msgid "not applied"
msgstr "未应用"

msgid "interface down"
msgstr "接口未 UP"

msgid "%d client(s) online"
msgstr "%d 台设备在线"
