
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_re3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_wr3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_yuncore_ax835=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_gatonetworks_gdsp=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netgear_wax220=n

# ---- build only xiaomi ax3000t to cut build time ----
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_ax3000t=y

# ---- proxy: passwall2 with sing-box core (xray 26.11.9 in rolling feed needs
#      go >= 1.27 but the golang package provides 1.26.11 with GOTOOLCHAIN=local;
#      sing-box's Makefile declares golang1.27 and builds fine) ----
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=n

# ---- ssl: explicitly select mbedtls + ustream-ssl mbedtls variant.
#      Feed kconfig has recursive-dep errors that leave libustream-mbedtls
#      selected for build without its libmbedtls dep -> cmake NOTFOUND.
#      Selecting both makes the variant buildable regardless of puller. ----
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libustream-mbedtls=y

# ---- passwall v1 (used by luci-app-wifiproxy for per-interface ACL binding;
#      sing-box core only -- xray needs go >= 1.27 in the rolling feed) ----
CONFIG_PACKAGE_luci-app-wifiproxy=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n

# ---- remote access / mesh ----
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# alternatives (uncomment to enable):
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
# CONFIG_PACKAGE_luci-app-homeproxy=y
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-tailscale-next=y
# CONFIG_PACKAGE_luci-app-frpc-next=y