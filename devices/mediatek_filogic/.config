
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_re3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_wr3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_yuncore_ax835=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_gatonetworks_gdsp=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netgear_wax220=n

# ---- build only xiaomi ax3000t to cut build time ----
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_ax3000t=y

# ---- proxy: passwall2 with xray core only (sing-box skipped to save flash) ----
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=n
CONFIG_PACKAGE_xray-core=y

# ---- remote access / mesh ----
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# alternatives (uncomment to enable):
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
# CONFIG_PACKAGE_luci-app-homeproxy=y
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-tailscale-next=y
# CONFIG_PACKAGE_luci-app-frpc-next=y